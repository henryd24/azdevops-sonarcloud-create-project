{
    "id": "eb138da3-8f57-4bd3-8423-21e78d7db984",
    "name": "sonarcloud-create-project",
    "friendlyName": "SonarCloud create project",
    "description": "Extension to check if a project exists in sonar and if not, create it.",
    "helpMarkDown": "",
    "category": "Utility",
    "author": "Henry Mosquera",
    "version": {
        "Major": 1,
        "Minor": 1,
        "Patch": 0
    },
    "visibility": [
        "Release",
        "Build"
    ],
    "instanceNameFormat": "SonarCloud Create Project",
    "groups": [
        {
            "name": "newCodeDefinitionGroup",
            "displayName": "Code Definition Options",
            "isExpanded": false
        }
    ],

    "inputs": [
        {
            "name": "SonarCloud",
            "type": "connectedService:sonarcloud",
            "label": "SonarCloud Service Connection",
            "required": true,
            "helpMarkDown": "Select the SonarCloud endpoint for your project. To create one, click on the Manage link and create a new SonarCloud Service Endpoint, then enter your SonarCloud account token."
        },
        {
            "name": "sonarOrganization",
            "type": "pickList",
            "label": "Organization",
            "required": true,
            "helpMarkDown": "Select your organization.",
            "properties": {
              "EditableOptions": "True"
            }
        },
        {
            "name": "serviceKey",
            "type": "string",
            "label": "Project keyname",
            "defaultValue": "",
            "required": true,
            "helpMarkDown": "Define the key name of the sonar project, e.g.: front-angular."
        },
        {
            "name": "serviceName",
            "type": "string",
            "label": "Project name",
            "defaultValue": "",
            "required": false,
            "helpMarkDown": "Define the name of the project in sonar, e.g. Front Angular."
        },
        {
            "name": "createProject",
            "type": "radio",
            "label": "Create project (if it does not exist)",
            "defaultValue": "true",
            "required": true,
            "helpMarkDown": "Create project (Yes) | Only check existence (No).",
            "options": {
                "true": "Yes",
                "false": "No"
            }
        },
        {
            "name": "mainBranch", 
            "type": "string",
            "label": "Main Branch Name",
            "defaultValue": "",
            "required": false,
            "visibleRule": "createProject = true",
            "helpMarkDown": "Define the main branch name, e.g., trunk or release. (Optional)"
        },
        {
            "name": "visibility",
            "type": "radio",
            "label": "Visibility",
            "defaultValue": "private",
            "required": true,
            "visibleRule": "createProject = true",
            "helpMarkDown": "Project visibility: private or public.",
            "options": {
                "private": "Private",
                "public": "Public"
            }
        },
        {
            "name": "tags",
            "type": "string",
            "label": "Tags",
            "visibleRule": "createProject = true",
            "required": false,
            "helpMarkDown": "Set comma-separated tags e.g.: dev,back,node."
        },
        {
            "name": "long_live_branches",
            "type": "string",
            "label": "Long-lived branches (regex)",
            "visibleRule": "createProject = true",
            "required": false,
            "helpMarkDown": "Long-lived branches (regex), e.g.: (master|qa). (Optional)"
        },
        {
            "name": "sonarQualityGate",
            "type": "pickList",
            "label": "Select the quality gate",
            "visibleRule": "createProject = true",
            "required": false,
            "helpMarkDown": "Select the quality gate you want to configure in the project. (Optional)",
            "properties": {
              "EditableOptions": "True"
            }
        },
        {
            "name": "enableNewCodeDefinition",
            "groupName": "newCodeDefinitionGroup",
            "type": "boolean",
            "label": "Configure New Code Definition",
            "defaultValue": "false",
            "required": false,
            "visibleRule": "createProject = true",
            "helpMarkDown": "Check to configure new code definition options. (Optional)"
        },
        {
            "name": "newCodeDefinitionType",
            "groupName": "newCodeDefinitionGroup",
            "type": "radio",
            "label": "New Code Definition Type",
            "defaultValue": "previous_version",
            "visibleRule": "enableNewCodeDefinition = true",
            "required": false,
            "helpMarkDown": "Select the new code definition type. (Optional)",
            "options": {
                "previous_version": "Previous Version",
                "days": "Days",
                "date": "Date",
                "version": "Version"
            }
        },
        {
            "name": "newCodeDefinitionValue",
            "groupName": "newCodeDefinitionGroup",
            "type": "string",
            "label": "New Code Definition Value",
            "defaultValue": "",
            "required": false,
            "visibleRule": "enableNewCodeDefinition = true && newCodeDefinitionType != previous_version",
            "helpMarkDown": "Define the value for the new code definition type selected. (Optional)"
        }
    ],
    "dataSourceBindings": [
        {
          "target": "sonarOrganization",
          "endpointId": "$(SonarCloud)",
          "endpointUrl": "{{endpoint.url}}/api/organizations/search?member=true",
          "resultSelector": "jsonpath:$.organizations[*]",
          "resultTemplate":
            "{ \"Value\" : \"{{{key}}}\", \"DisplayValue\" : \"{{{name}}} ({{{key}}})\" }"
        },
        {
          "target": "sonarQualityGate",
          "endpointId": "$(SonarCloud)",
          "endpointUrl": "{{endpoint.url}}/api/qualitygates/list?organization=$(sonarOrganization)",
          "resultSelector": "jsonpath:$.qualitygates[*]",
          "resultTemplate":
            "{ \"Value\" : \"{{{id}}}\", \"DisplayValue\" : \"{{{name}}} ({{{id}}})\" }"
        }
    ],
    "execution": {
        "Node20_1": {
            "target": "./index.js"
        },
        "Node24": {
            "target": "./index.js"
        }
    }
}
